# PostgreSQL connection used by the loader, pipeline, API and dashboard
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5432/apguard

# Required for write endpoints (PATCH /flags/{id}, POST /runs). Unset = writes disabled.
APGUARD_API_KEY=

# Comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:8501

# Set to true on public deployments to hide the review form in the dashboard
APGUARD_DASHBOARD_READ_ONLY=false

# Only for `pytest -m db`: a DISPOSABLE database the tests will drop and rebuild
APGUARD_TEST_DATABASE_URL=
